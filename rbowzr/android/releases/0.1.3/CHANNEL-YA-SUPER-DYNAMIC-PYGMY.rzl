{
  "schema": "rzl.transport.v1",
  "id": "channel-ya.super-dynamic-pygmy",
  "name": "Super Dynamic Pygmy",
  "version": "1.0.0",
  "kind": "app",
  "host": "ЯBOWZR",
  "channel": "Я",
  "system": "ЯOS",
  "entry": "seed-shell/index.html",
  "offline": true,
  "oneEgg": true,
  "oneShell": true,
  "oneTile": true,
  "seedShell": {
    "kind": "browser",
    "host": "ЯBOWZR",
    "entry": "seed-shell/index.html",
    "sealedUntilValidated": true,
    "revealsOneTile": true
  },
  "transport": {
    "portable": true,
    "canSend": true,
    "canDownload": true,
    "contentType": "application/vnd.rizal.rzl",
    "openWith": "info.rizal.rbowzr.native",
    "display": "gold-dragon-egg",
    "payload": "validated-inner-tile",
    "icon": {
      "mime": "image/png",
      "encoding": "base64",
      "sha256": "094416ae91714dffd9f3bc02579a53c7bd7ff3835db9481a5dec6cbc945a6c7c",
      "data": ""
    }
  },
  "roles": [
    "ЯBOT",
    "ЯOS",
    "ЯKode",
    "ЯKLASSROOM",
    "ЯID"
  ],
  "platforms": [
    "android",
    "ios",
    "ipados",
    "linux",
    "macos"
  ],
  "platformDetection": {
    "mode": "inner-egg-beacon",
    "host": "ЯBOWZR",
    "sameShell": true,
    "sameComponents": true,
    "adapters": {
      "android": "native-android-shell",
      "ios": "native-ios-shell",
      "ipados": "native-ipados-shell",
      "linux": "native-linux-shell",
      "macos": "native-macos-shell"
    }
  }
}
